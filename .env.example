# TrashDrop Mobile Collector Driver App - Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key


# Default Location (Fallback coordinates if geolocation fails)
VITE_DEFAULT_LATITUDE=5.6037
VITE_DEFAULT_LONGITUDE=-0.1870

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
google_maps_api_key=your_google_maps_api_key_here

# API Configuration (not needed for mobile app)

# Application Settings
VITE_APP_NAME=TrashDrop
VITE_APP_VERSION=1.0.0

# TrendiPay Gateway Configuration (Phase 4)
# Enable/disable real payment processing
VITE_ENABLE_TRENDIPAY=true

# TrendiPay/BSL public settings (get from the TrendiPay/BSL dashboard)
# Test environment: https://test-api.bsl.com.gh
# Production environment: https://merchant-api.trendipay.com
# The API key and webhook secret are NOT set here: every VITE_ variable the
# app reads ends up in the browser bundle. They are Supabase Edge Function
# secrets (TRENDIPAY_API_KEY, TRENDIPAY_WEBHOOK_SECRET); see
# supabase/functions/trendipay-proxy and trendipay-webhook.
VITE_TRENDIPAY_API_URL=https://test-api.bsl.com.gh
VITE_TRENDIPAY_TERMINAL_ID=your_trendipay_terminal_id
VITE_TRENDIPAY_MERCHANT_ID=your_trendipay_merchant_id

# Supabase Edge Functions URL for webhook callbacks (TrendiPay will send payment status updates here)
# This is automatically derived from VITE_SUPABASE_URL if not set.
# Only set this if you have a custom webhook server URL.
# Example: https://<project-ref>.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=

# Legacy / fallback base URL (deprecated — callbackBaseUrl now auto-derives from VITE_SUPABASE_URL)
VITE_API_URL=

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Never put the service role key in a VITE_ variable: Vite bundles every VITE_ value into the public app
VITE_SUPABASE_SERVICE_KEY=

# Default Location (Fallback coordinates if geolocation fails)
VITE_DEFAULT_LATITUDE=5.6037
VITE_DEFAULT_LONGITUDE=-0.1870
REACT_APP_MAP_DEFAULT_ZOOM=13


# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
google_maps_api_key=your_google_maps_api_key

# Development Mode User ID (only used when DEV_MODE = true)
VITE_DEV_USER_ID=

