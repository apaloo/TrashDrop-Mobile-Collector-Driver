{
  "name": "trashdrop-mobile-collector-driver",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "\\.(png|jpe?g|gif|webp|avif|svg|ico|mp3|wav|mp4|webm)$": "<rootDir>/test/fileMock.js"
    }
  },
  "dependencies": {
    "@sentry/react": "8.55.2",
    "@supabase/supabase-js": "^2.119.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "autoprefixer": "^10.6.2",
    "framer-motion": "^12.43.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "leaflet.offline": "^3.2.2",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.2.0",
    "tailwindcss": "^3.4.19",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@cypress/react": "^9.0.2",
    "@cypress/webpack-dev-server": "^4.1.1",
    "@cypress/webpack-preprocessor": "^6.0.4",
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "cypress": "^14.5.4",
    "cypress-vite": "^1.10.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7"
  }
}
